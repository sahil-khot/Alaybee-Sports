# ==============================================================================
# Alaybee Sports — Server Environment Configuration Template
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@<cluster-url>/alaybee_sports?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.alaybee.mongodb.net/alaybee_sports?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong, random 32+ character string in production)
JWT_SECRET=alaybee_sports_super_secret_jwt_key_2026_sports

# JWT Token Expiration (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Node Environment ('development' or 'production')
NODE_ENV=development
